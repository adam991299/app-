# Copy this file to .env and fill in your own values.
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time and is
# NOT secret — it ships inside the app binary. Never put a service-role key, a
# webhook signing secret, or anything else sensitive behind an EXPO_PUBLIC_ name.
#
# If none of these are set, the app runs fully in local "demo mode" (see lib/demo/)
# instead of failing — see README.md.

# --- Supabase --------------------------------------------------------------
# Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat --------------------------------------------------------------
# Project → API Keys → Apple App Store
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=

# --- PostHog (analytics) -----------------------------------------------------
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- EAS ---------------------------------------------------------------------
# Set after running `eas init` — see app.config.ts
EAS_PROJECT_ID=

# -----------------------------------------------------------------------------
# The variables below are server-only (used by supabase/seed/seed.ts and Supabase
# Edge Functions). They are NOT read by the app itself and must never be prefixed
# EXPO_PUBLIC_ — export them in your shell (or a separate untracked .env.seed) when
# running the seed script, and set them as Supabase secrets for the Edge Functions.

# Project → Settings → API → service_role key (bypasses Row Level Security — treat
# like a root password. Only ever used server-side.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# supabase secrets set ADMIN_CONTENT_SECRET=<a-long-random-string>
ADMIN_CONTENT_SECRET=

# supabase secrets set REVENUECAT_WEBHOOK_SECRET=<matches the value set in RevenueCat>
REVENUECAT_WEBHOOK_SECRET=
