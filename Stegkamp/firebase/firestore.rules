rules_version = '2';

// Fas 0: allt är stängt. Reglerna öppnas steg för steg i fas 2 (profiler), 3 (tävlingar och steg)
// och 5 (Swish-uppgifter), med emulator-tester för varje regel.
// Cloud Functions använder Admin SDK och påverkas inte av reglerna.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
