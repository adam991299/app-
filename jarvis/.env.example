# Kopiera inte för hand – kör scripts/init-env.sh, som skapar .env med slumpade
# lösenord och rättigheterna 600. .env committas aldrig.

# Databas och Grafana (slumpas av init-env.sh)
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Domännamn för appen. "localhost" fungerar lokalt.
JARVIS_DOMAIN=localhost
# Engångskod för att skapa din första passkey i appen (Inställningar). Skapas av
# scripts/init-env.sh. Ta bort raden när passkeyn finns, så kan ingen annan skapa en.
JARVIS_PASSKEY_SETUP_CODE=

# IBKR Paper-konto för boten (fylls i av Adam, behövs från Fas 0.5)
IBKR_PAPER_USERNAME=
IBKR_PAPER_PASSWORD=
# Papperskontots nummer (börjar med DU), från Settings → Paper Trading Account
IBKR_PAPER_ACCOUNT=

# Larm via e-post (valfritt, gratis). Skapa ett eget Gmail-konto för Jarvis och ett
# applösenord (Google-konto → Säkerhet → Applösenord). Lämna tomt för larm bara i loggen.
JARVIS_SMTP_HOST=
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_ALERT_EMAIL=
