GRAFANA_ADMIN_PASSWORD=

# Domännamn för appen. "localhost" fungerar lokalt.
JARVIS_DOMAIN=localhost

# IBKR Paper-konto för boten (fylls i av Adam, behövs från Fas 0.5)
IBKR_PAPER_USERNAME=
IBKR_PAPER_PASSWORD=
